<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>0.1.0</Version>
    <Authors>Insomnia for Windows contributors</Authors>
    <Product>Insomnia</Product>
    <Copyright>Copyright (c) 2026 Krish Garg and contributors</Copyright>
    <!-- Analyzer rules that fight the project's deliberate style. -->
    <NoWarn>$(NoWarn);CA1848;CA1716;CA1711;CA1720;CA1805;CA1031;CA1303;CA1515;CA2007;CA1002;CA2227;CA1819;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA1062;CA1724;CA1054;CA1056;CA1055;CA5394;CA1024;CA1508;CA1812;CA1859;CA1822</NoWarn>
  </PropertyGroup>
</Project>
