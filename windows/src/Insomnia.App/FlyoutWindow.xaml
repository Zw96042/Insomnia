<Window x:Class="Insomnia.App.FlyoutWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Insomnia.App.Controls"
        Title="Insomnia"
        Width="392"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        FontFamily="{DynamicResource Font.Text}"
        FontSize="14"
        Foreground="{DynamicResource Brush.TextPrimary}"
        KeyboardNavigation.TabNavigation="Cycle"
        KeyboardNavigation.ControlTabNavigation="Cycle"
        AutomationProperties.Name="Insomnia">
    <!--
      Anchored above the tray like Windows 11's own flyouts. The hero strip
      mirrors the upstream menu bar: the eye, then either the Days / Hours /
      Minutes pills (idle) or the live countdown with hold-to-end (active).
      Both states share the same cells, so switching never resizes the window;
      only transforms and opacity animate.
    -->
    <Grid x:Name="Root" Focusable="True" FocusVisualStyle="{x:Null}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="Body" Margin="20,20,20,16">
            <!-- Hero strip -->
            <Grid Height="48">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <c:EyeMark x:Name="Eye" Width="40" Height="40" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextPrimary}" />
                <Grid Grid.Column="2">
                    <c:DurationEntry x:Name="StartEntry" HorizontalAlignment="Left" VerticalAlignment="Center" />
                    <Grid x:Name="CountdownStrip" Visibility="Hidden">
                        <c:CountdownText x:Name="Countdown" HorizontalAlignment="Left" VerticalAlignment="Center"
                                         RenderTransformOrigin="0,0.5"
                                         TextElement.FontFamily="{DynamicResource Font.Display}"
                                         TextElement.FontSize="34"
                                         TextElement.FontWeight="SemiBold"
                                         TextElement.Foreground="{DynamicResource Brush.TextPrimary}"
                                         Typography.NumeralAlignment="Tabular" />
                        <c:HoldToEndButton x:Name="HoldToEnd" HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" />
                    </Grid>
                </Grid>
            </Grid>

            <!-- One line under the strip: what Enter will do, or when the session ends. -->
            <Grid Margin="52,2,0,0" MinHeight="18">
                <TextBlock x:Name="Subline" Style="{StaticResource Text.Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,72,0" />
                <TextBlock x:Name="HoldHint" Style="{StaticResource Text.Caption}" Text="Hold to end" HorizontalAlignment="Right"
                           Foreground="{DynamicResource Brush.TextTertiary}" Visibility="Hidden" />
            </Grid>

            <!-- Idle and active bodies share this cell. -->
            <Grid Margin="0,18,0,0">
                <StackPanel x:Name="IdleBody">
                    <WrapPanel x:Name="Presets" Margin="-3,-3,-3,0" AutomationProperties.Name="Presets" />
                    <Button x:Name="StartButton" Style="{StaticResource Button.Accent}" Content="Start session" Height="36" Margin="0,14,0,0"
                            HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel x:Name="ActiveBody" Visibility="Hidden">
                    <TextBlock Style="{StaticResource Text.CaptionStrong}" Text="Add time" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <c:DurationEntry x:Name="ExtendEntry" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <Button x:Name="ExtendButton" Grid.Column="1" Content="Add" MinWidth="56" Height="34" Margin="8,0,0,0" HorizontalAlignment="Stretch" />
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- Start, extend and end failures, with the engine's message. -->
            <Border x:Name="ErrorBar" Style="{StaticResource InfoBar.Critical}" Margin="0,14,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ErrorGlyph" Style="{StaticResource Text.Icon}" Text="&#xEA39;" Foreground="{DynamicResource Brush.Critical}"
                               VerticalAlignment="Top" Margin="0,1,10,0" />
                    <TextBlock x:Name="ErrorText" Grid.Column="1" Style="{StaticResource Text.Body}" FontSize="13" />
                </Grid>
            </Border>

            <!-- Warnings from the engine, each with its action. Built in code so additions can animate. -->
            <StackPanel x:Name="WarningsPanel" Margin="0,14,0,0" Visibility="Collapsed" AutomationProperties.Name="Warnings" />
        </StackPanel>

        <!-- Footer band, as on Windows 11 quick settings. -->
        <Border Grid.Row="1" Background="{DynamicResource Brush.FlyoutFooter}" BorderBrush="{DynamicResource Brush.Divider}"
                BorderThickness="0,1,0,0" Padding="10,8">
            <Grid>
                <Button x:Name="SettingsButton" Style="{StaticResource Button.Subtle}" HorizontalAlignment="Left" Padding="10,5,12,6"
                        AutomationProperties.Name="Settings">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{DynamicResource Font.Icons}" FontSize="16" Text="&#xE713;" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <TextBlock Text="Settings" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="MoreButton" Style="{StaticResource Button.Icon}" HorizontalAlignment="Right" Content="&#xE712;"
                        ToolTip="Status and more" AutomationProperties.Name="Status and more" />
            </Grid>
        </Border>
    </Grid>
</Window>
