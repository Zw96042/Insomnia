<Application x:Class="Insomnia.App.App"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 0: palette, replaced by ThemeManager with Light, Dark or a high contrast map. -->
                <ResourceDictionary Source="Theme/Light.xaml" />
                <!-- 1: accent brushes from the system accent, filled in by ThemeManager. -->
                <ResourceDictionary />
                <!-- 2: control styles; every color is a DynamicResource into 0 and 1. -->
                <ResourceDictionary Source="Theme/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
