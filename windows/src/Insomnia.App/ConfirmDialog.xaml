<Window x:Class="Insomnia.App.ConfirmDialog"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Insomnia"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Topmost="True"
        UseLayoutRounding="True"
        FontFamily="{DynamicResource Font.Text}"
        FontSize="14"
        Foreground="{DynamicResource Brush.TextPrimary}">
    <!-- A Windows 11 content dialog: heading, message, then a footer band with the actions. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="24,20,24,24">
            <TextBlock x:Name="Heading" Style="{StaticResource Text.Subtitle}" TextWrapping="Wrap" />
            <TextBlock x:Name="Message" Style="{StaticResource Text.Body}" Margin="0,12,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource Brush.FlyoutFooter}" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ConfirmButton" Style="{StaticResource Button.Accent}" IsDefault="True" />
                <Button x:Name="CancelButton" Grid.Column="2" Content="Cancel" IsCancel="True" />
            </Grid>
        </Border>
    </Grid>
</Window>
