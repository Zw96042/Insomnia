<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Insomnia.App.Controls"
                    xmlns:a="clr-namespace:Insomnia.App.Animation">
    <!--
      Windows 11 control styles for Insomnia. Every color comes from the
      palette (Theme/Light.xaml, Theme/Dark.xaml, or the high contrast map)
      through DynamicResource, so a theme switch restyles live windows.
    -->

    <!-- Type -->
    <FontFamily x:Key="Font.Text">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Small">Segoe UI Variable Small, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Focus: the Windows 11 two-tone ring, keyboard only. -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="7" BorderThickness="2" BorderBrush="{DynamicResource Brush.FocusOuter}" SnapsToDevicePixels="True">
                        <Border CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource Brush.FocusInner}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FocusVisual.Circle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Ellipse Margin="-1" StrokeThickness="2" Stroke="{DynamicResource Brush.FocusOuter}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FocusVisual.Pill">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="17" BorderThickness="2" BorderBrush="{DynamicResource Brush.FocusOuter}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text -->
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Text}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Text.BodyStrong" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Text.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Small}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Text.CaptionStrong" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Text.Subtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Display}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style x:Key="Text.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Display}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>
    <Style x:Key="Text.Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Icons}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Buttons: one template; the styles differ only in brushes and shape. -->
    <ControlTemplate x:Key="Template.Button" TargetType="ButtonBase">
        <Border x:Name="Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{Binding Path=(c:Ui.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}"
                Padding="{TemplateBinding Padding}"
                SnapsToDevicePixels="True">
            <ContentPresenter x:Name="Content"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True"
                              TextElement.Foreground="{TemplateBinding Foreground}" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{Binding Path=(c:Ui.HoverBackground), RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{Binding Path=(c:Ui.PressedBackground), RelativeSource={RelativeSource TemplatedParent}}" />
                <Setter TargetName="Content" Property="TextElement.Foreground" Value="{Binding Path=(c:Ui.PressedForeground), RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Background" Value="{Binding Path=(c:Ui.DisabledBackground), RelativeSource={RelativeSource TemplatedParent}}" />
                <Setter TargetName="Content" Property="TextElement.Foreground" Value="{DynamicResource Brush.TextDisabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Button.Standard" TargetType="ButtonBase">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Text}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.ControlFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.ControlStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,5,12,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="c:Ui.CornerRadius" Value="4" />
        <Setter Property="c:Ui.HoverBackground" Value="{DynamicResource Brush.ControlFillHover}" />
        <Setter Property="c:Ui.PressedBackground" Value="{DynamicResource Brush.ControlFillPressed}" />
        <Setter Property="c:Ui.PressedForeground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="c:Ui.DisabledBackground" Value="{DynamicResource Brush.ControlFillDisabled}" />
        <Setter Property="Template" Value="{StaticResource Template.Button}" />
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource Button.Standard}" />

    <Style x:Key="Button.Accent" TargetType="ButtonBase" BasedOn="{StaticResource Button.Standard}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextOnAccent}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="c:Ui.HoverBackground" Value="{DynamicResource Brush.AccentHover}" />
        <Setter Property="c:Ui.PressedBackground" Value="{DynamicResource Brush.AccentPressed}" />
        <Setter Property="c:Ui.PressedForeground" Value="{DynamicResource Brush.TextOnAccent}" />
    </Style>

    <Style x:Key="Button.Subtle" TargetType="ButtonBase" BasedOn="{StaticResource Button.Standard}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="c:Ui.HoverBackground" Value="{DynamicResource Brush.SubtleHover}" />
        <Setter Property="c:Ui.PressedBackground" Value="{DynamicResource Brush.SubtlePressed}" />
        <Setter Property="c:Ui.DisabledBackground" Value="Transparent" />
    </Style>

    <Style x:Key="Button.Icon" TargetType="ButtonBase" BasedOn="{StaticResource Button.Subtle}">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Icons}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="Button.Link" TargetType="ButtonBase" BasedOn="{StaticResource Button.Subtle}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
        <Setter Property="Padding" Value="6,3,6,4" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="c:Ui.PressedForeground" Value="{DynamicResource Brush.AccentText}" />
    </Style>

    <Style x:Key="Button.Chip" TargetType="ButtonBase" BasedOn="{StaticResource Button.Standard}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="Padding" Value="12,3,12,4" />
        <Setter Property="c:Ui.CornerRadius" Value="14" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual.Pill}" />
        <Setter Property="a:Motion.BounceOnClick" Value="True" />
    </Style>

    <!-- Text input: rounded well with the accent underline on focus. -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Text}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.InputFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.ControlStroke}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,5,10,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Root" CornerRadius="4" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border x:Name="Underline" CornerRadius="0,0,4,4" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.InputStrokeBottom}" />
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        <TextBlock x:Name="Hint" Margin="{TemplateBinding Padding}" Padding="2,0,0,0" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                   Text="{Binding Path=(c:Ui.Placeholder), RelativeSource={RelativeSource TemplatedParent}}"
                                   Foreground="{DynamicResource Brush.TextTertiary}" IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.InputFillHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.InputFillFocused}" />
                            <Setter TargetName="Underline" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Underline" Property="BorderThickness" Value="0,0,0,2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.ControlFillDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Text}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.InputFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.ControlStroke}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,5,10,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid>
                        <Border x:Name="Root" CornerRadius="4" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border x:Name="Underline" CornerRadius="0,0,4,4" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.InputStrokeBottom}" />
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.InputFillHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.InputFillFocused}" />
                            <Setter TargetName="Underline" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Underline" Property="BorderThickness" Value="0,0,0,2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.ControlFillDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Scroll bars: a thin rounded thumb that widens under the pointer. -->
    <Style x:Key="ScrollBar.PageButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollBar.Thumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" Background="{DynamicResource Brush.ScrollThumb}" CornerRadius="3" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollBar.PageButton}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollBar.PageButton}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Thumb" Style="{StaticResource ScrollBar.Thumb}" Width="3" HorizontalAlignment="Center" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Thumb" Property="Width" Value="6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollBar.PageButton}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollBar.PageButton}" />
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb x:Name="Thumb" Style="{StaticResource ScrollBar.Thumb}" Height="3" VerticalAlignment="Center" />
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Thumb" Property="Height" Value="6" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Tool tips: the shadow sits on its own layer so the text keeps ClearType. -->
    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Text}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Grid Margin="8,4,8,10" MaxWidth="320">
                        <Border Background="{DynamicResource Brush.ToolTipFill}" CornerRadius="4">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="1" Color="{DynamicResource Color.Shadow}" />
                            </Border.Effect>
                        </Border>
                        <Border Background="{DynamicResource Brush.ToolTipFill}" BorderBrush="{DynamicResource Brush.MenuStroke}" BorderThickness="1"
                                CornerRadius="4" Padding="9,6,9,8">
                            <ContentPresenter>
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menus -->
    <Style TargetType="ContextMenu">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Text}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="MinWidth" Value="240" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Grid x:Name="MenuRoot" Margin="12,8,12,16">
                        <Border Background="{DynamicResource Brush.MenuFill}" CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="6" Direction="270" Opacity="1" Color="{DynamicResource Color.Shadow}" />
                            </Border.Effect>
                        </Border>
                        <Border Background="{DynamicResource Brush.MenuFill}" BorderBrush="{DynamicResource Brush.MenuStroke}" BorderThickness="1"
                                CornerRadius="8" Padding="0,3,0,3">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" Margin="0" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="0,3" Background="{DynamicResource Brush.Divider}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Text}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Padding" Value="12,0,12,0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Margin" Value="4,1" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}"
                            MinHeight="{TemplateBinding MinHeight}" SnapsToDevicePixels="True">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="MenuGlyph" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Glyph" Style="{StaticResource Text.Icon}" Width="16" Margin="0,0,12,0" FontSize="16"
                                       Text="{Binding Path=(c:Ui.Glyph), RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{Binding Path=(c:Ui.GlyphBrush), RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter x:Name="Header" Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                              VerticalAlignment="Center" Margin="0,6,0,7" />
                            <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="24,0,0,0" FontSize="12"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="c:Ui.Glyph" Value="{x:Null}">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="c:Ui.GlyphBrush" Value="{x:Null}">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.SubtleHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.SubtlePressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A read-only status line in the tray menu: small, secondary, never focused. -->
    <Style x:Key="MenuItem.Status" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>

    <!-- A section label in the tray menu. -->
    <Style x:Key="MenuItem.Section" TargetType="MenuItem" BasedOn="{StaticResource MenuItem.Status}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>

    <!-- Surfaces -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.CardFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.CardStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="InfoBar.Critical" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.CriticalBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.CardStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="14,10" />
    </Style>
    <Style x:Key="InfoBar.Caution" TargetType="Border" BasedOn="{StaticResource InfoBar.Critical}">
        <Setter Property="Background" Value="{DynamicResource Brush.CautionBackground}" />
    </Style>
    <Style x:Key="InfoBar.Info" TargetType="Border" BasedOn="{StaticResource InfoBar.Critical}">
        <Setter Property="Background" Value="{DynamicResource Brush.InfoBackground}" />
    </Style>

    <!-- Duration pill: a fixed slot with a soft focus glow and a "?" help badge. -->
    <Style TargetType="c:PillField">
        <Setter Property="Height" Value="40" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Text}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.PillFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.PillStroke}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:PillField">
                    <Grid>
                        <Border x:Name="PART_Glow" Margin="-2" CornerRadius="12" BorderThickness="2"
                                BorderBrush="{DynamicResource Brush.Accent}" Opacity="0" IsHitTestVisible="False">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.6" Color="{DynamicResource Color.Accent}" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Well" CornerRadius="10" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="12,0,8,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid VerticalAlignment="Center">
                                    <!-- The slot: the placeholder at the typed weight, never drawn. -->
                                    <TextBlock Text="{TemplateBinding Placeholder}" FontWeight="SemiBold" Visibility="Hidden" />
                                    <TextBlock x:Name="Hint" Text="{TemplateBinding Placeholder}" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource Brush.PillPlaceholder}" Visibility="Hidden" />
                                    <TextBlock x:Name="PART_Value" Text="{TemplateBinding Text}" HorizontalAlignment="Center"
                                               FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                                </Grid>
                                <Border x:Name="Badge" Grid.Column="1" Width="16" Height="16" CornerRadius="8" Margin="8,0,0,0"
                                        BorderThickness="1" BorderBrush="{DynamicResource Brush.TextTertiary}" Background="Transparent"
                                        Cursor="Help" ToolTip="{TemplateBinding Help}" ToolTipService.InitialShowDelay="250">
                                    <TextBlock Text="?" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextTertiary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="{x:Null}">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Well" Property="Background" Value="{DynamicResource Brush.PillFillHover}" />
                        </Trigger>
                        <Trigger Property="IsInvalid" Value="True">
                            <Setter TargetName="Well" Property="BorderBrush" Value="{DynamicResource Brush.Critical}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Well" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Toggle switch -->
    <Style TargetType="c:ToggleSwitch">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Text}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:ToggleSwitch">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" />
                        <TextBlock x:Name="State" Grid.Column="1" Text="Off" Margin="12,0,12,0" MinWidth="24" VerticalAlignment="Center" TextAlignment="Right" />
                        <Grid Grid.Column="2" Width="40" Height="20">
                            <Border x:Name="Track" CornerRadius="10" BorderThickness="1"
                                    BorderBrush="{DynamicResource Brush.ToggleOffStroke}" Background="{DynamicResource Brush.ToggleOffFill}" />
                            <Ellipse x:Name="PART_Knob" Width="12" Height="12" Fill="{DynamicResource Brush.ToggleOffKnob}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="PART_Knob" Property="Fill" Value="{DynamicResource Brush.TextOnAccent}" />
                            <Setter TargetName="State" Property="Text" Value="On" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Stepper: − value + -->
    <Style TargetType="c:Stepper">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Text}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:Stepper">
                    <Border Background="{DynamicResource Brush.ControlFill}" BorderBrush="{DynamicResource Brush.ControlStroke}" BorderThickness="1"
                            CornerRadius="4" Height="32" SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="PART_Down" Style="{StaticResource Button.Icon}" Width="32" Height="30" FontSize="12"
                                    Content="&#xE738;" IsTabStop="False" Focusable="False" AutomationProperties.Name="Decrease" />
                            <TextBlock Text="{TemplateBinding DisplayText}" MinWidth="56" TextAlignment="Center" VerticalAlignment="Center"
                                       Typography.NumeralAlignment="Tabular" />
                            <Button x:Name="PART_Up" Style="{StaticResource Button.Icon}" Width="32" Height="30" FontSize="12"
                                    Content="&#xE710;" IsTabStop="False" Focusable="False" AutomationProperties.Name="Increase" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Settings card -->
    <Style TargetType="c:SettingsCard">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Text}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:SettingsCard">
                    <Border Background="{DynamicResource Brush.CardFill}" BorderBrush="{DynamicResource Brush.CardStroke}" BorderThickness="1"
                            CornerRadius="4" Padding="16,12,16,12" MinHeight="66" SnapsToDevicePixels="True">
                        <Grid VerticalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="IconGlyph" Style="{StaticResource Text.Icon}" FontSize="20" Margin="2,0,18,0" Text="{TemplateBinding Icon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                                <TextBlock x:Name="Desc" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" Text="{TemplateBinding Description}" />
                            </StackPanel>
                            <ContentPresenter Grid.Column="2" Margin="24,0,0,0" VerticalAlignment="Center" />
                            <ContentPresenter x:Name="PART_Footer" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,12,0,0"
                                              Content="{TemplateBinding Footer}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconGlyph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="Desc" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Footer" Value="{x:Null}">
                            <Setter TargetName="PART_Footer" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Settings navigation -->
    <Style x:Key="NavList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="FontFamily" Value="{DynamicResource Font.Text}" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
                    <Setter Property="Margin" Value="0,1" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Grid>
                                    <Border x:Name="Root" Background="Transparent" CornerRadius="4" Height="36" Padding="16,0,12,0">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                    <Border x:Name="Indicator" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                            Background="{DynamicResource Brush.Accent}" Visibility="Hidden" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.SubtleHover}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.SubtleHover}" />
                                        <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
